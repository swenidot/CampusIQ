# ==========================================
# CampusIQ Environment Configuration
# ==========================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# Google Gemini API Key (get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Embeddings & ChromaDB Settings
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=campusiq_docs

# MCP Server Security & Config
MCP_AUTH_TOKEN=your_mcp_auth_token_here
MCP_SERVER_TOKEN=your_mcp_auth_token_here
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8001

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000

# OpenTelemetry Observability
OTEL_SERVICE_NAME=campusiq
OTEL_TRACES_EXPORTER=console,file
OTEL_LOG_FILE=./traces/traces.jsonl
